TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OPENAI_API_KEY=
# Optional rollback/override; defaults to gpt-transcribe.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Optional destination for leads captured by the presentation demo bot.
# Without it, leads are emitted as structured application logs.
DEMO_LEAD_WEBHOOK_URL=
DEMO_LEAD_WEBHOOK_TOKEN=
# Defaults to the existing Slovak Google WaveNet voice.
TWILIO_DEMO_VOICE=Google.sk-SK-Wavenet-A
# Optional separate encryption key for portable demo-call state.
# TWILIO_AUTH_TOKEN is used when this is empty.
VOICE_BOT_STATE_SECRET=

# Existing PriXi production integration
PRIXI_API_URL=
PRIXI_API_KEY=
PRIXI_MOCK_MODE=false

# BulkGate Advanced Transactional API v2
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
BULKGATE_SMS_SENDER=

# NEUROCENTRUM Levice production voice bot. Runtime settings and Curo delivery
# are owned by EDS; the gateway only reads config and posts versioned events.
# Optional aliases; by default PRIXI_API_URL and PRIXI_API_KEY are reused.
EDS_API_URL=
EDS_VOICE_API_TOKEN=
EDS_VOICE_API_TIMEOUT_MS=2500
EDS_VOICE_EVENT_ATTEMPTS=3
EDS_VOICE_CONFIG_CACHE_TTL_MS=30000
EDS_VOICE_CONFIG_LKG_TTL_MS=300000
